# Docker / 容器运行所需的内核配置（当前只被 LineageOS 线使用）
#
# 用法（见 .github/workflows/build_LineageOS-Kernel.yml）：
#   1. Build-Kernel job 第一步 actions/checkout 到 $WORKSPACE/builder
#   2. Make defconfig 步骤把本文件拷进内核树 arch/<arch>/configs/docker.config
#   3. scripts/kconfig/merge_config.sh -m -O <out> <out>/.config <该片段>
#   4. make olddefconfig
#
# ⚠️ 为什么必须先「拷进内核树」：
#    workflow 里的片段路径是相对**内核源码树**解析的（arch/${arch}/configs/<frag>），
#    放在本仓库根目录不会被任何步骤读到 —— 之前这个文件就是因为没被引用而完全没生效。
#
# ⚠️ 每一行的依赖都在 LineageOS/android_kernel_xiaomi_sdm845@lineage-22.2 的 Kconfig
#    里逐条核对过。注意 merge_config.sh -m **不做依赖校验**：它那段
#    「Value requested for $CFG not in final .config」的检查写在 RUNMAKE=false 分支
#    之后，-m 模式下直接 exit，永远跑不到。依赖不满足会被 make olddefconfig
#    **静默丢弃** —— 所以 workflow 末尾有断言兜底（必需项报错、可选项告警）。
#
# mi845_defconfig 已经开好、这里不必重复声明的项：
#   CONFIG_CGROUP_FREEZER / CONFIG_CGROUP_CPUACCT / CONFIG_CPUSETS /
#   CONFIG_CGROUP_SCHED / CONFIG_MEMCG / CONFIG_MEMCG_SWAP / CONFIG_KEYS /
#   CONFIG_NF_CONNTRACK / CONFIG_NF_CONNTRACK_IPV6 / CONFIG_NF_NAT /
#   CONFIG_NF_NAT_IPV4 / CONFIG_IP_NF_NAT / CONFIG_IP_NF_TARGET_MASQUERADE /
#   CONFIG_NETFILTER_XT_MATCH_CONNTRACK / CONFIG_NETFILTER_XT_MARK /
#   CONFIG_NETFILTER_ADVANCED / CONFIG_IOSCHED_CFQ / CONFIG_DUMMY /
#   CONFIG_BRIDGE / CONFIG_OVERLAY_FS / CONFIG_SCHED_WALT / CONFIG_PROFILING

# ---- 命名空间（容器隔离的基础）----
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
# 可选项，且是安全取舍：打开后容器可用 user namespace 做 uid 映射。
# Android 历来默认关闭 USER_NS（历史上是提权攻击面之一）。
# 如果你不用 docker run --userns-remap，可以删掉这一行，Docker 照常工作。
CONFIG_USER_NS=y

# ---- SysV IPC / POSIX 消息队列 ----
# ⚠️ CONFIG_IPC_NS 的 Kconfig 是 "depends on (SYSVIPC || POSIX_MQUEUE)"，
#    本树这两项都没有默认值（= n），两个都不开的话 IPC_NS 必然被 olddefconfig 丢掉。
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
# 注意：CONFIG_SYSVIPC_SYSCTL 是**无 prompt 的派生符号**（default y，依赖 SYSVIPC && SYSCTL），
# 写在这里也改不动它的值，所以不列 —— 只要 SYSVIPC=y，它自然就是 y。

# ---- cgroup 控制器 ----
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
# BLK_CGROUP 定义在 init/Kconfig（不是 block/Kconfig），是下面两项的前置
CONFIG_BLK_CGROUP=y
# 依赖 BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
# 依赖 IOSCHED_CFQ && BLK_CGROUP
CONFIG_CFQ_GROUP_IOSCHED=y
# 依赖 PERF_EVENTS；本树 CONFIG_PROFILING=y → PERF_EVENTS 默认 y
CONFIG_CGROUP_PERF=y
# 依赖 CGROUPS；会 select CGROUP_NET_CLASSID
CONFIG_NET_CLS_CGROUP=y
# 依赖 CGROUPS
CONFIG_CGROUP_NET_PRIO=y

# ---- 容器网络驱动 ----
CONFIG_VETH=y
CONFIG_DUMMY=y
CONFIG_MACVLAN=y
# ⚠️ IPVLAN 依赖 NET_L3_MASTER_DEV（net/l3mdev/Kconfig 里的可见 bool，默认 n），
#    不一起打开的话 IPVLAN 会被静默丢掉
CONFIG_NET_L3_MASTER_DEV=y
CONFIG_IPVLAN=y
# VXLAN 会 select NET_UDP_TUNNEL，不用手写
CONFIG_VXLAN=y
CONFIG_BRIDGE=y
# BRIDGE_VLAN_FILTERING 依赖 VLAN_8021Q
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE_VLAN_FILTERING=y
# 依赖 BRIDGE && NETFILTER && INET && NETFILTER_ADVANCED(=y)
CONFIG_BRIDGE_NETFILTER=y

# ---- netfilter / iptables ----
# NETFILTER_ADVANCED 在本内核是 default y；下面这几项在 ADVANCED=y 时没有默认值，必须显式打开
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP_VS=y
# 依赖 NF_CONNTRACK（已开）
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=y
# 依赖 IP_VS && NETFILTER_ADVANCED && NF_CONNTRACK
CONFIG_NETFILTER_XT_MATCH_IPVS=y
# IPv6 NAT：IP6_NF_NAT 自己会 select NF_NAT_IPV6 和 NETFILTER_XT_NAT，
# 所以不必单独写 CONFIG_NF_NAT_IPV6
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# ---- 存储驱动 ----
# overlay2 存储驱动需要 OVERLAY_FS；ext4 的 POSIX ACL 影响卷权限
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y

# ============================================================================
# 以下项目故意不开，写在这里是为了避免以后有人「顺手补上」：
#
# CONFIG_CFS_BANDWIDTH
#   本内核 CONFIG_SCHED_WALT=y，而它 "depends on !SCHED_WALT" —— 永远开不了。
#   后果：docker run --cpu-quota / --cpu-period 不可用（--cpus 也不行）。
#   这是高通 WALT 调度器与 CFS 带宽控制的结构性冲突，改不了。
#
# CONFIG_CGROUP_HUGETLB
#   依赖 HUGETLB_PAGE，arm64 手机内核通常不开大页，与 Docker 无关。
#
# IP_SCTP / NF_TABLES / NFT_* / SECURITY_APPARMOR
#   都属于 docker check-config.sh 的「Optional Features」，不影响 Docker 正常使用。
#   4.9 内核上 Docker 默认走 iptables-legacy，不需要 nftables。
#   本内核的 nftables 版本较老（没有 NFT_FIB_IPV4 / NFT_FIB_IPV6）。
#   Android 用 SELinux，不需要 AppArmor。
#
# CONFIG_BTRFS_FS
#   可选存储驱动，手机上用不到。
# ============================================================================
